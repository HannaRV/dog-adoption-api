        {
          "name": "GET Dog Statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has summary with total\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response.summary).to.have.property('total');\r",
                  "    pm.expect(response.summary.total).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"byAge has x and y arrays\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response.byAge.x).to.be.an('array');\r",
                  "    pm.expect(response.byAge.y).to.be.an('array');\r",
                  "    pm.expect(response.byAge.x.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"byState is an object with state codes\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response.byState).to.be.an('object');\r",
                  "    pm.expect(Object.keys(response.byState).length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"booleans has house_trained with true and false counts\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response.booleans.house_trained).to.have.property('true');\r",
                  "    pm.expect(response.booleans.house_trained).to.have.property('false');\r",
                  "});"
                ],
