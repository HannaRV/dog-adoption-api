		{
			"name": "GET All Dogs",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response has dogs array\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response.dogs).to.be.an('array');\r",
							"});\r",
							"\r",
							"pm.test(\"Response has pagination\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response._pagination).to.have.property('totalDogs');\r",
							"    pm.expect(response._pagination).to.have.property('page');\r",
							"});\r",
							"\r",
							"pm.test(\"Response has HATEOAS links\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response._links).to.have.property('self');\r",
							"});\r",
							"\r",
							"pm.test(\"Pagination page is a number\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response._pagination.page).to.be.a('number');\r",
							"});\r",
							"\r",
							"pm.test(\"Dog ID is a string\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response.dogs[0].id).to.be.a('string');\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"if (response.dogs && response.dogs.length > 0) {\r",
							"    pm.environment.set(\"dogId\", response.dogs[0].id);\r",
							"}"
