{
  "info": {
    "_postman_id": "00c3a9db-3221-4089-beaf-650276a95b0f",
    "name": "Dog Adoption API",
    "description": "This collection tests the Dog Adoption API. Authentication tests use randomized credentials (email and username) generated in pre-request scripts to avoid conflicts between test runs. Test users are not cleaned up after each run as the API has no DELETE /users endpoint — randomized credentials ensure no conflicts between runs. The CRUD sequence (POST → PUT → DELETE) cleans up dog entries created during testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "40098002"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains token\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response.token).to.be.a('string');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(Math.random() * 100000);\r",
                  "pm.environment.set(\"randomUsername\", `testuser_${randomNum}`);\r",
                  "pm.environment.set(\"randomEmail\", `test_${randomNum}@test.com`);\r",
                  "pm.environment.set(\"randomPassword\", \"Password123!\");"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"{{randomUsername}}\",\r\n    \"email\": \"{{randomEmail}}\",\r\n    \"password\": \"{{randomPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
