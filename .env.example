# ------------------------------------------------------------------------
# Configuration template - Copy this file and rename it to .env
# ------------------------------------------------------------------------

# Server Configuration
PORT=3000
NODE_ENV='development'
API_BASE_URL='http://localhost:3000'

# Database Configuration
MONGODB_URI='mongodb+srv://<username>:<password>@cluster.mongodb.net/dog-adoption-api'

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET='add_a_secret_string_here'
JWT_EXPIRES_IN='1h'

# CSV Paths (only needed locally for seeding)
# CSV_PATH_DOGS='./src/utils/seeds/data/dogs.csv'
# CSV_PATH_LOCATIONS='./src/utils/seeds/data/locations.csv'
# CSV_PATH_TRAVEL='./src/utils/seeds/data/travel.csv'
